# Copia este archivo a .env (o ejecuta ./setup.sh, que además genera los secretos).
# .env está en .gitignore: nunca lo subas al repositorio.

# --- Base de datos (PostgreSQL local en Docker) ---
POSTGRES_USER=sanl
POSTGRES_PASSWORD=cambia_esta_contrasena
POSTGRES_DB=sanl

# --- Seguridad ---
# Mínimo 32 caracteres. Generar uno: openssl rand -hex 32
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio
JWT_EXPIRE_MINUTES=480

# --- IA - Gemini (RF-11). Opcional: sin llave, el resto del sistema funciona ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Agenda ---
APP_TIMEZONE=America/Mexico_City

# --- Usuarios iniciales ---
# Crea un administrador al arrancar (si no existe). Deja vacío para omitirlo.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Datos de demostración (admin/nutri/paciente @example.com, contraseña DEMO_PASSWORD). SOLO para desarrollo.
SEED_DEMO_DATA=true
DEMO_PASSWORD=Demo1234!

# --- Puertos publicados en localhost (evitan choques con otros proyectos) ---
FRONTEND_PORT=3100
BACKEND_PORT=8100
DB_PORT=5433
